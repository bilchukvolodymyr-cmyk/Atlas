# ATLAS_HOST is replaced by install.sh (e.g. 203-0-113-7.sslip.io or your own domain).
# Caddy gets and renews the HTTPS certificate automatically.
ATLAS_HOST {
	encode gzip
	request_body {
		max_size 64KB
	}
	reverse_proxy 127.0.0.1:8710
	log {
		output file /var/log/caddy/atlas.log
		format json
	}
}
